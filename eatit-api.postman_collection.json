{
  "info": {
    "_postman_id": "eatit-api-collection-v1",
    "name": "EatIt API",
    "description": "Backend EatIt — Fastify REST API with JWT authentication.\n\n**Setup:**\n1. `base_url` est déjà configuré sur `http://localhost:3000`\n2. Exécuter **Login** → `{{token}}` et `{{refresh_token}}` sont sauvegardés automatiquement\n3. Toutes les routes authentifiées utilisent `{{token}}` via le Bearer auth de la collection\n4. Remplacer `{{restaurant_id}}`, `{{dish_id}}`, `{{order_id}}` avec de vrais IDs après les créations\n\n**Rôles:**\n- `USER` : créer et voir ses commandes\n- `RESTAURANT` : gérer ses restaurants et plats, voir ses commandes\n- `ADMIN` : créer des restaurants",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "auth": {
    "type": "bearer",
    "bearer": [{ "key": "token", "value": "{{token}}", "type": "string" }]
  },
  "variable": [
    { "key": "base_url", "value": "http://localhost:3000", "type": "default" },
    { "key": "token", "value": "", "type": "default" },
    { "key": "refresh_token", "value": "", "type": "default" },
    { "key": "restaurant_id", "value": "REPLACE_ME", "type": "default" },
    { "key": "dish_id", "value": "REPLACE_ME", "type": "default" },
    { "key": "order_id", "value": "REPLACE_ME", "type": "default" }
  ],
  "item": [
    {
      "name": "Auth",
      "item": [
        {
          "name": "Register",
          "request": {
            "auth": { "type": "noauth" },
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"user@example.com\",\n  \"password\": \"password123\",\n  \"firstname\": \"John\",\n  \"lastname\": \"Doe\",\n  \"city\": \"Paris\",\n  \"cp\": \"75001\",\n  \"address\": \"1 rue de la Paix\",\n  \"phoneNumber\": \"+33600000000\",\n  \"picture\": \"https://example.com/avatar.jpg\"\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": {
              "raw": "{{base_url}}/api/auth/register",
              "host": ["{{base_url}}"],
              "path": ["api", "auth", "register"]
            },
            "description": "Register a new user account. Returns the created user (role defaults to USER)."
          },
          "response": [
            {
              "name": "201 Created",
              "status": "Created",
              "code": 201,
              "header": [
                { "key": "Content-Type", "value": "application/json" }
              ],
              "_postman_previewlanguage": "json",
              "body": "{\n  \"id\": \"cmb1abc123def\",\n  \"email\": \"user@example.com\",\n  \"role\": \"USER\",\n  \"firstname\": \"John\",\n  \"lastname\": \"Doe\",\n  \"city\": \"Paris\",\n  \"cp\": \"75001\",\n  \"address\": \"1 rue de la Paix\",\n  \"phoneNumber\": \"+33600000000\",\n  \"picture\": \"https://example.com/avatar.jpg\"\n}"
            },
            {
              "name": "400 Bad Request",
              "status": "Bad Request",
              "code": 400,
              "header": [
                { "key": "Content-Type", "value": "application/json" }
              ],
              "_postman_previewlanguage": "json",
              "body": "{\n  \"error\": {\n    \"statusCode\": 400,\n    \"message\": \"body/email must match format \\\"email\\\"\"\n  }\n}"
            },
            {
              "name": "409 Conflict",
              "status": "Conflict",
              "code": 409,
              "header": [
                { "key": "Content-Type", "value": "application/json" }
              ],
              "_postman_previewlanguage": "json",
              "body": "{\n  \"error\": {\n    \"statusCode\": 409,\n    \"message\": \"Email already in use\"\n  }\n}"
            }
          ]
        },
        {
          "name": "Login",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "var res = pm.response.json();",
                  "if (res.token) {",
                  "  pm.collectionVariables.set('token', res.token);",
                  "  console.log('Token saved:', res.token.substring(0, 20) + '...');",
                  "}",
                  "if (res.refreshToken) {",
                  "  pm.collectionVariables.set('refresh_token', res.refreshToken);",
                  "  console.log('Refresh token saved');",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "auth": { "type": "noauth" },
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"user@example.com\",\n  \"password\": \"password123\"\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": {
              "raw": "{{base_url}}/api/auth/login",
              "host": ["{{base_url}}"],
              "path": ["api", "auth", "login"]
            },
            "description": "Login and receive JWT access + refresh tokens.\n\n**Le test script sauvegarde automatiquement `{{token}}` et `{{refresh_token}}`.**"
          },
          "response": [
            {
              "name": "200 OK",
              "status": "OK",
              "code": 200,
              "header": [
                { "key": "Content-Type", "value": "application/json" }
              ],
              "_postman_previewlanguage": "json",
              "body": "{\n  \"token\": \"eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpZCI6ImNtYjFhYmMxMjMiLCJpYXQiOjE3NDc1MDAwMDB9.SIGNATURE\",\n  \"refreshToken\": \"eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpZCI6ImNtYjFhYmMxMjMiLCJpYXQiOjE3NDc1MDAwMDB9.SIGNATURE\"\n}"
            },
            {
              "name": "401 Unauthorized",
              "status": "Unauthorized",
              "code": 401,
              "header": [
                { "key": "Content-Type", "value": "application/json" }
              ],
              "_postman_previewlanguage": "json",
              "body": "{\n  \"error\": {\n    \"statusCode\": 401,\n    \"message\": \"Invalid credentials\"\n  }\n}"
            }
          ]
        },
        {
          "name": "Refresh Token",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "var res = pm.response.json();",
                  "if (res.token) {",
                  "  pm.collectionVariables.set('token', res.token);",
                  "  console.log('New token saved');",
                  "}",
                  "if (res.refreshToken) {",
                  "  pm.collectionVariables.set('refresh_token', res.refreshToken);",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "auth": { "type": "noauth" },
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"refreshToken\": \"{{refresh_token}}\"\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": {
              "raw": "{{base_url}}/api/auth/refresh",
              "host": ["{{base_url}}"],
              "path": ["api", "auth", "refresh"]
            },
            "description": "Rotate refresh token and get a new access token. The old refresh token is invalidated."
          },
          "response": [
            {
              "name": "200 OK",
              "status": "OK",
              "code": 200,
              "header": [
                { "key": "Content-Type", "value": "application/json" }
              ],
              "_postman_previewlanguage": "json",
              "body": "{\n  \"token\": \"eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...\",\n  \"refreshToken\": \"eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...\"\n}"
            },
            {
              "name": "401 Unauthorized - expired",
              "status": "Unauthorized",
              "code": 401,
              "header": [
                { "key": "Content-Type", "value": "application/json" }
              ],
              "_postman_previewlanguage": "json",
              "body": "{\n  \"error\": {\n    \"statusCode\": 401,\n    \"message\": \"Invalid or expired refresh token\"\n  }\n}"
            }
          ]
        },
        {
          "name": "Get Me (JWT payload)",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base_url}}/api/auth/me",
              "host": ["{{base_url}}"],
              "path": ["api", "auth", "me"]
            },
            "description": "Get the currently authenticated user's id, email and role from JWT payload."
          },
          "response": [
            {
              "name": "200 OK",
              "status": "OK",
