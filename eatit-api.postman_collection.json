              ],
              "_postman_previewlanguage": "json",
              "body": "{\n  \"id\": \"cmb1abc123def\",\n  \"email\": \"user@example.com\",\n  \"role\": \"USER\"\n}"
            },
            {
              "name": "401 Unauthorized",
              "status": "Unauthorized",
              "code": 401,
              "header": [
                { "key": "Content-Type", "value": "application/json" }
              ],
              "_postman_previewlanguage": "json",
              "body": "{\n  \"error\": {\n    \"statusCode\": 401,\n    \"message\": \"Unauthorized\"\n  }\n}"
            }
          ]
        }
      ]
    },
